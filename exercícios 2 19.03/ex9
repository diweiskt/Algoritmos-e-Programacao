'''
Calcule o imposto de renda de um contribuinte, onde o usuário informe o valor anual recebido 
e o sistema mostra o cálculo do imposto de renda de acordo com a tabela progressiva abaixo.

Base de Cálculo Anual em R$ 	  Alíquota %  
    Até 17.989,80	                  –
    De 17.989,81 até 26.961,00	     7,5
    De 26.961,01 até 35.948,40	     15,0
    De 35.948,41 até 44.918,28	     22,5
    Acima de 44.918,28	             27,5
'''

valor_anual = float(input('Informe o valor anual recebido: '))
if valor_anual <= 17989.80:
    imposto = 0
elif valor_anual >= 17989.81 and valor_anual <= 26961.00:
    imposto = valor_anual * 0.075
elif valor_anual >= 26961.01 and valor_anual <= 35948.40:
    imposto = valor_anual * 0.15
elif valor_anual >= 35948.41 and valor_anual <= 44918.28:
    imposto = valor_anual * 0.225
else:
    valor_anual > 44918.28
    imposto = valor_anual * 0.275
print('Salário anual: R${}'.format(valor_anual))
print('Imposto de renda: R${:.2f}'.format(imposto))