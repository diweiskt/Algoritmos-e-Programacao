'''
Leia 3 valores inteiros e diferentes e a seguir, encontre e exiba o maior, o menor e o intermediário.
'''

while True:
    v1 = int(input('Digite um valor: '))
    v2 = int(input('Digite outro Valor: '))
    v3 = int(input('Digite outro Valor: '))
    if v1 != v2 and v1 != v3 and v2 != v3:
        break
    else:
        print('Os valores devem ser DIFERENTES, tente novamente: ')
if v1 > v2 and v1 > v3:
    maior = v1
    if v2 > v3:
        intermediario = v2
        menor = v3
    else:
        intermediario = v3
        menor = v2
elif v2 > v1 and v2 > v3:
    maior = v2
    if v1 > v3:
        intermediario = v1
        menor = v3
    else:
        intermediario = v3
        menor = v1
else:
    maior = v3
    if v2 > v1:
        intermediario = v2
        menor = v1
    else:
        intermediario = v1
        menor = v2
print('O valor maior é:',maior)
print('O valor intermediario é:',intermediario)
print('O valor menor é :',menor)    