'''
1. Calcule a média ponderada de um aluno. 
Considere para isso três notas com pesos 
3 (prova A), 5 (prova B) e 2 (trabalhos)
'''

provaA = float(input('Qual a nota da Prova A ' ))
provaB = float(input('Qual a nota da Prova B ' ))
trabalho = float(input('Qual a nota do Trabalho? ' ))
notafinal = round(provaA * 0.3) + (provaB * 0.5) + (trabalho * 0.2)
print('A Média do aluno é: ',notafinal)